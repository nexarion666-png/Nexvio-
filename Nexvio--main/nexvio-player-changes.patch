+        if (!playerPrefs.getBoolean("auto_subtitles", true)) return@LaunchedEffect
+        val code = subtitleLanguageCode(playerPrefs.getString("preferred_subtitle_language", "Device language") ?: "Device language")
+            ?: return@LaunchedEffect
+        var waited = 0
+        while (active.playbackState != Player.STATE_READY && waited < 300) { delay(200); waited++ }
+        if (active.playbackState != Player.STATE_READY || active.isCurrentMediaItemLive) return@LaunchedEffect
+        val textGroups = active.currentTracks.groups.filter { it.type == C.TRACK_TYPE_TEXT }
+        if (textGroups.any { it.isSelected }) return@LaunchedEffect
+        // 1) Prefer an embedded track in the preferred language.
+        for (group in textGroups) {
+            val index = (0 until group.length).firstOrNull { group.getTrackFormat(it).language.orEmpty().startsWith(code, ignoreCase = true) }
+            if (index != null) {
+                active.trackSelectionParameters = active.trackSelectionParameters.buildUpon()
+                    .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, false)
+                    .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, listOf(index)))
+                    .build()
+                return@LaunchedEffect
+            }
+        }
+        // 2) Re-use the subtitle already saved for this video, if any.
+        val cached = java.io.File(context.cacheDir, "nexvio_subtitle_" + channel.id.hashCode() + ".vtt")
+        try {
+            if (cached.exists() && cached.length() > 0L) {
+                applySubtitleFile(cached, SubtitleOption("cached", code, "Subtitle", ""))
+                return@LaunchedEffect
+            }
+        } catch (e: Exception) { Log.w("NexvioSubtitles", "Cached subtitle failed: ${e.message}") }
+        // 3) Search online and apply the best match (try up to 3 candidates).
+        val apiKey = BuildConfig.OPENSUBTITLES_API_KEY
+        if (apiKey.isBlank()) return@LaunchedEffect
+        try {
+            val candidates = withContext(Dispatchers.IO) { searchBestSubtitles(apiKey, channel.name, code) }
+            for (option in candidates.take(3)) {
+                try {
+                    val file = withContext(Dispatchers.IO) { downloadSubtitleVtt(context.cacheDir, channel.id, option.fileId) }
+                    applySubtitleFile(file, option)
+                    showPlayerMessage("Subtitles loaded (${code.uppercase()})")
+                    return@LaunchedEffect
+                } catch (e: CancellationException) { throw e
+                } catch (e: Exception) { Log.w("NexvioSubtitles", "Auto subtitle candidate failed: ${e.message}") }
+            }
+        } catch (e: CancellationException) { throw e
+        } catch (e: Exception) { Log.w("NexvioSubtitles", "Auto subtitle search failed: ${e.message}") }
+    }
