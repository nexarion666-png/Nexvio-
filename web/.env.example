# Use the same Supabase project configured in the Android app.
# These must be the project URL and publishable (client-safe) key, never a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# TMDB's browser API key is public/client-side. Set it in Vercel project environment variables.
VITE_TMDB_API_KEY=your-tmdb-api-key
